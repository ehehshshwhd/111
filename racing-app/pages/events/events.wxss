.events-page{width:100%;height:calc(100vh - 140rpx - env(safe-area-inset-bottom));background:#f5f6f7;box-sizing:border-box;overflow:hidden;position:relative}.events-scroll{width:100%;height:100%;box-sizing:border-box;padding:24rpx 0;overflow-y:scroll;position:relative;z-index:1;-webkit-overflow-scrolling:touch}.event-card{position:relative;width:100%;background:#fff;border-radius:0;overflow:hidden;margin:0 0 34rpx;box-shadow:0 5rpx 18rpx #00000012}.event-card + .event-card{margin-top:30rpx}.event-poster{width:100%;display:block}.hero-poster{height:330rpx;position:relative;overflow:hidden;background:linear-gradient(135deg,#214980 0%,#8daec4 48%,#171412 100%);color:#fff;padding:56rpx 30rpx;box-sizing:border-box}.hero-poster:after{content:'';position:absolute;right:-70rpx;bottom:-80rpx;width:380rpx;height:330rpx;background:radial-gradient(ellipse,#29211c 0 35%,transparent 36%),linear-gradient(145deg,#806a51,#151311);transform:rotate(-12deg)}.hero-kicker{position:relative;z-index:1;color:#ed151c;font-size:46rpx;font-weight:900;text-shadow:2rpx 3rpx #fff}.hero-name{position:relative;z-index:1;font-size:46rpx;font-weight:900;margin-top:22rpx;text-shadow:2rpx 3rpx #0008}.hero-place{position:relative;z-index:1;font-size:25rpx;margin-top:72rpx}.hero-mark{position:absolute;right:26rpx;top:30rpx;z-index:2;color:#ffe43e;background:#7d180d;border:4rpx solid #4c2412;padding:7rpx;font-size:18rpx;text-align:center}.event-body{padding:28rpx 30rpx 27rpx}.event-title{font-size:31rpx;line-height:1.4;color:#151515;margin-bottom:22rpx;word-break:break-all}.event-line{display:flex;align-items:flex-start;gap:12rpx;color:#9a9da1;font-size:27rpx;line-height:1.5;margin-top:15rpx}.event-line text:nth-child(2){flex:1;min-width:0}.line-icon{font-size:34rpx;color:#9a9da1;width:28rpx;flex:none}.event-status{margin-left:auto;color:#ff9700;font-size:27rpx;white-space:nowrap}.event-notice{color:#ff9700;font-size:27rpx;margin-top:18rpx}
.event3-poster{height:330rpx;position:relative;overflow:hidden;background:linear-gradient(135deg,#0c6a9b 0%,#66c4c6 48%,#143049 100%);color:#fff;padding:56rpx 30rpx;box-sizing:border-box}.event3-poster:after{content:"";position:absolute;right:-70rpx;bottom:-110rpx;width:430rpx;height:300rpx;background:radial-gradient(ellipse at 35% 45%,#172d38 0 28%,transparent 29%),linear-gradient(145deg,#89a6a5,#1f3941);transform:rotate(-8deg);opacity:.9}.event3-kicker,.event3-name,.event3-place{position:relative;z-index:1;text-shadow:2rpx 3rpx #0008}.event3-kicker{font-size:34rpx;font-weight:700}.event3-name{font-size:42rpx;font-weight:900;margin-top:22rpx}.event3-place{font-size:25rpx;margin-top:72rpx}.event3-badge{position:absolute;right:26rpx;top:30rpx;z-index:2;color:#ffe43e;background:#7d180d;border:4rpx solid #4c2412;padding:7rpx;font-size:18rpx;text-align:center}


