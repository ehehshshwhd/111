/* Team score card layout */
.score-result-group-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.score-virtual-badge{padding:6rpx 12rpx;border-radius:16rpx;background:#fff3df;color:#bd7418;font-size:21rpx;line-height:28rpx;white-space:nowrap}
.score-team-list{padding-top:30rpx}.score-team-card{margin-bottom:22rpx;padding:24rpx 22rpx 26rpx;background:#fff;border:1rpx solid #e3e8e9;border-radius:16rpx;box-shadow:0 4rpx 14rpx rgba(22,61,73,.06)}.score-team-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:18rpx;border-bottom:1rpx solid #edf0f1}.score-car-label{color:#7a8d92;font-size:24rpx;line-height:32rpx}.score-car-number{margin-left:14rpx;color:#172f38;font-size:38rpx;line-height:46rpx;font-weight:700;letter-spacing:1rpx}.score-rank{display:flex;align-items:center;gap:12rpx;color:#7c8e93;font-size:23rpx;line-height:32rpx}.score-rank strong{color:#f28a00;font-size:40rpx;line-height:46rpx;font-weight:700}.score-crew-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx 10rpx;padding:22rpx 0 18rpx}.score-crew-member{display:flex;align-items:center;min-width:0}.score-crew-avatar{width:66rpx;height:66rpx;flex:none;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:50%;background:#fff1cf;color:#c47a16;font-size:25rpx}.score-crew-avatar image{width:100%;height:100%}.score-crew-copy{min-width:0;margin-left:12rpx}.score-crew-role,.score-crew-name,.score-crew-country{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.score-crew-role{color:#788a8f;font-size:22rpx;line-height:28rpx}.score-crew-name{margin-top:2rpx;color:#1c3037;font-size:26rpx;line-height:34rpx}.score-crew-country{margin-top:1rpx;color:#8d9b9f;font-size:21rpx;line-height:28rpx}.score-team-name{display:flex;align-items:center;gap:16rpx;padding:14rpx 0 18rpx;border-top:1rpx solid #edf0f1;color:#75868b;font-size:24rpx;line-height:34rpx}.score-team-name text:last-child{color:#273a40}.score-time-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx 12rpx;padding-top:16rpx;border-top:1rpx solid #edf0f1}.score-time-grid view{display:flex;flex-direction:column;min-width:0}.score-time-grid text{color:#869499;font-size:22rpx;line-height:30rpx}.score-time-grid strong{margin-top:4rpx;color:#273a40;font-family:"SFMono-Regular",Consolas,monospace;font-size:25rpx;line-height:34rpx;font-weight:500;white-space:nowrap}.score-time-grid .score-highlight{color:#f28a00;font-size:28rpx;font-weight:700}
/* 成绩详情使用独立全屏内容区，避免底部弹层截断车队卡片 */
.score-result-sheet{height:100vh;border-radius:0;padding-bottom:env(safe-area-inset-bottom)}
