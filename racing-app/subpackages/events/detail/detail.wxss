.score-time-grid .score-highlight{font-size:29rpx;color:#f28a00;font-weight:500}
.score-result-note{display:none}
.score-publish-state{padding:100rpx 30rpx;text-align:center;color:#365a62;font-size:28rpx;line-height:1.6}
.score-stage-record{margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #edf0f1}
.score-stage-record-title{margin-bottom:10rpx;color:#718186;font-size:24rpx}
.score-stage-record-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx 18rpx}
.score-stage-record-grid view{display:flex;flex-direction:column;min-width:0}
.score-stage-record-grid text{color:#78888d;font-size:22rpx;line-height:30rpx}
.score-stage-record-grid strong{margin-top:3rpx;color:#273a40;font-family:"SFMono-Regular",Consolas,monospace;font-size:24rpx;line-height:34rpx;font-weight:400;overflow-wrap:anywhere}
.score-published-total{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding-top:14rpx;border-top:1rpx solid #edf0f1;color:#78888d;font-size:24rpx}
.score-published-total strong{color:#f28a00;font-size:29rpx;font-weight:600}

/* 成绩表使用页面原生导航栏标题，避免与“赛事详情”叠出第二层导航。 */
.score-result-header{display:none}
.score-result-scroll{height:calc(100vh - env(safe-area-inset-bottom));padding-top:28rpx}
.score-rank-1,.score-rank-1 strong{color:#f4c400}
.score-rank-2,.score-rank-2 strong{color:#a9adb0}
.score-rank-3,.score-rank-3 strong{color:#b96b3d}
.score-trophy-1{color:#d89b00}
.score-trophy-1 .score-trophy-bowl{background:linear-gradient(135deg,#ffe77a,#e4a300)}
.score-trophy-2 .score-trophy-handle{border-color:#858d94}
.score-trophy-2 .score-trophy-stem,.score-trophy-2 .score-trophy-base{background:#858d94;box-shadow:0 6rpx 0 -1rpx #858d94}
.score-trophy-2 .score-trophy-bowl{background:linear-gradient(135deg,#edf0f2,#a6adb3)}
.score-trophy-3 .score-trophy-handle{border-color:#98502e}
.score-trophy-3 .score-trophy-stem,.score-trophy-3 .score-trophy-base{background:#98502e;box-shadow:0 6rpx 0 -1rpx #98502e}
.score-trophy-3 .score-trophy-bowl{background:linear-gradient(135deg,#e9ae7e,#b56b3d)}
.generic-detail-poster{margin-top:30rpx}
.generic-detail-copy{white-space:pre-wrap}
